{
  "name": "@takustaqu/atmosphere",
  "version": "0.3.1",
  "description": "A WebGL renderer that reproduces the sky from time and weather",
  "type": "module",
  "license": "MIT",
  "author": "takustaqu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takustaqu/atmosphere.git"
  },
  "homepage": "https://github.com/takustaqu/atmosphere#readme",
  "bugs": {
    "url": "https://github.com/takustaqu/atmosphere/issues"
  },
  "keywords": [
    "webgl",
    "sky",
    "clouds",
    "weather",
    "procedural",
    "shader",
    "background",
    "skybox"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/types/examples/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./react/styles.css": {
      "types": "./dist/react/atmosphere.css.d.ts",
      "default": "./dist/react/atmosphere.css"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/types/src/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src",
    "examples",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "build:site": "node scripts/build-site.mjs",
    "prepack": "pnpm run build",
    "playground": "esbuild examples/playground/main.ts examples/controller/main.ts --bundle --format=esm --outdir=build --outbase=examples --watch --servedir=. --serve=8791"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "esbuild": "^0.28.1",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
